# PowerTech Alpine Rust
# Rust development and cross-compilation environment
# 8 cargo cross-compilation targets: Linux musl/gnu, macOS, Windows MSVC (x64/arm64 each)
#
# Image: ghcr.io/powertech-center/alpine/cross-rust

FROM ghcr.io/powertech-center/alpine/cross-platform:latest

ENV RUSTUP_HOME=/opt/rust/rustup
ENV CARGO_HOME=/opt/rust/cargo

RUN --mount=type=bind,source=shared,target=/tmp/shared \
    sh /tmp/shared/rust.sh

ENV PATH="${CARGO_HOME}/bin:${PATH}"

RUN rustup component add llvm-tools && \
    rustup target add \
        x86_64-unknown-linux-musl \
        aarch64-unknown-linux-musl \
        x86_64-unknown-linux-gnu \
        aarch64-unknown-linux-gnu \
        x86_64-pc-windows-msvc \
        aarch64-pc-windows-msvc \
        x86_64-apple-darwin \
        aarch64-apple-darwin

# =============================================================================
# C compiler environment variables (Rust cc crate)
# CC_<target>  — C compiler wrapper for each cross-compilation target
# CXX_<target> — C++ compiler wrapper for each cross-compilation target
# Wrappers are defined in alpine-cross-platform.
# =============================================================================

# Linux musl targets
ENV CC_x86_64_unknown_linux_musl=clang-x86_64-linux-musl
ENV CXX_x86_64_unknown_linux_musl=clang++-x86_64-linux-musl
ENV CC_aarch64_unknown_linux_musl=clang-aarch64-linux-musl
ENV CXX_aarch64_unknown_linux_musl=clang++-aarch64-linux-musl

# Linux gnu targets
ENV CC_x86_64_unknown_linux_gnu=clang-x86_64-linux-gnu
ENV CXX_x86_64_unknown_linux_gnu=clang++-x86_64-linux-gnu
ENV CC_aarch64_unknown_linux_gnu=clang-aarch64-linux-gnu
ENV CXX_aarch64_unknown_linux_gnu=clang++-aarch64-linux-gnu

# macOS targets
ENV CC_x86_64_apple_darwin=clang-x86_64-apple-darwin
ENV CXX_x86_64_apple_darwin=clang++-x86_64-apple-darwin
ENV CC_aarch64_apple_darwin=clang-aarch64-apple-darwin
ENV CXX_aarch64_apple_darwin=clang++-aarch64-apple-darwin

# Windows MSVC targets (clang --driver-mode=cl wrappers from alpine-cross-platform)
ENV CC_x86_64_pc_windows_msvc=clang-x86_64-windows-msvc
ENV CXX_x86_64_pc_windows_msvc=clang++-x86_64-windows-msvc
ENV CC_aarch64_pc_windows_msvc=clang-aarch64-windows-msvc
ENV CXX_aarch64_pc_windows_msvc=clang++-aarch64-windows-msvc

# AR for Windows MSVC targets (llvm-lib produces COFF archives for lld-link)
ENV AR_x86_64_pc_windows_msvc=llvm-lib
ENV AR_aarch64_pc_windows_msvc=llvm-lib

# =============================================================================
# Linker environment variables (Cargo)
# CARGO_TARGET_<TRIPLE>_LINKER — linker for each target
#
# Rust linker invocation style differs by target:
#   - Linux musl/gnu, macOS: rustc passes GCC-driver flags (-Wl,*, -nostartfiles,
#     -mmacosx-version-min) → needs clang wrapper (translates flags, calls lld internally)
#   - Windows MSVC: rustc passes MSVC-style flags (/NOLOGO, /OPT:REF, /defaultlib:)
#     → needs lld wrapper (lld -flavor link understands these natively)
#
# Linux gnu targets are for native development on glibc desktops (not cross-compilation),
# so they also use clang wrappers but require a glibc sysroot to actually link.
#
# All clang/lld wrappers are defined in alpine-cross-platform.
# =============================================================================

# Linux musl linkers (clang driver: translates -Wl, flags → lld)
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=clang-x86_64-linux-musl
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=clang-aarch64-linux-musl

# Linux gnu linkers (clang driver: translates -Wl, flags → lld)
# NOTE: gnu targets require glibc sysroot — only usable on glibc-based hosts
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=clang-x86_64-linux-gnu
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=clang-aarch64-linux-gnu

# macOS linkers (clang driver: translates -Wl, and -mmacosx-version-min → ld64.lld)
ENV CARGO_TARGET_X86_64_APPLE_DARWIN_LINKER=clang-x86_64-apple-darwin
ENV CARGO_TARGET_AARCH64_APPLE_DARWIN_LINKER=clang-aarch64-apple-darwin

# Windows MSVC linkers (lld -flavor link: understands /NOLOGO, /OPT:REF natively)
# ENV takes highest priority in Cargo config and works regardless of CARGO_HOME
# (GitLab CI overrides CARGO_HOME to project dir for caching, which hides ~/.cargo/config.toml)
ENV CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER=lld-x86_64-windows-msvc
ENV CARGO_TARGET_AARCH64_PC_WINDOWS_MSVC_LINKER=lld-aarch64-windows-msvc

CMD ["/bin/sh"]
