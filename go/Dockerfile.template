# PowerTech {{ distro | capitalize }} Go (native)
# Go development environment for native (host) compilation
#
# Image: ghcr.io/powertech-center/{{ distro }}/go

FROM ghcr.io/powertech-center/{{ distro }}/dev:latest

# Install Go toolchain, dev tools (gopls, dlv, etc.), and set up GOPATH
RUN --mount=type=bind,source=shared,target=/tmp/shared \
    sh /tmp/shared/go.sh

ENV PATH="/usr/local/go/bin:/go/bin:${PATH}"
ENV GOPATH="/go"

CMD ["/bin/sh"]
