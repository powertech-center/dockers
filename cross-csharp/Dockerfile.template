# PowerTech Alpine C#
# .NET development and NativeAOT cross-compilation environment
#
# NativeAOT cross-compilation targets (8 native binary targets):
#   Linux:   linux-musl-x64, linux-musl-arm64, linux-x64, linux-arm64
#   macOS:   osx-x64, osx-arm64
#   Windows: win-x64, win-arm64
#
# Standard `dotnet publish` targets (managed IL):
#   All .NET RIDs including all of the above
#
# Image: ghcr.io/powertech-center/{{ distro }}/cross-csharp

FROM ghcr.io/powertech-center/{{ distro }}/cross-clang:latest

# Install .NET SDK and NativeAOT dependencies
RUN --mount=type=bind,source=shared,target=/tmp/shared \
    sh /tmp/shared/csharp.sh apk

ENV DOTNET_ROOT="/usr/share/dotnet"
ENV DOTNET_CLI_HOME=/opt/dotnet-tools
ENV PATH="${PATH}:/opt/dotnet-tools/.dotnet/tools"

# Install .NET dev tools to global path (accessible to all users)
RUN --mount=type=bind,source=shared,target=/tmp/shared \
    sh /tmp/shared/dev-tools-csharp.sh

# Pre-fetch NativeAOT ILC runtime packages for all 8 cross-compilation targets.
# This adds ~150 MB to the image but makes `dotnet publish -p:PublishAot=true`
# work instantly for any target without downloading packages at build time.
RUN --mount=type=bind,source=shared,target=/tmp/shared \
    sh /tmp/shared/csharp-prefetch.sh \
        linux-musl-x64 linux-musl-arm64 \
        linux-x64 linux-arm64 \
        osx-x64 osx-arm64 \
        win-x64 win-arm64

# =============================================================================
# NativeAOT cross-compilation environment
#
# .NET NativeAOT uses a C linker to produce the final native binary.
# All sysroots and clang/lld wrappers are inherited from cross-clang.
#
# Linux targets use MSBuild Unix.targets (CppCompilerAndLinker + SysRoot):
#   dotnet publish -r <rid> -p:PublishAot=true \
#     -p:CppCompilerAndLinker=<clang-wrapper> \
#     -p:SysRoot=<sysroot> \
#     -p:LinkerFlavor=lld -p:ObjCopyName=llvm-objcopy
#
# macOS targets use MSBuild Unix.targets (CppCompilerAndLinker + SysRoot):
#   dotnet publish -r <rid> -p:PublishAot=true \
#     -p:DisableUnsupportedError=true \
#     -p:CppCompilerAndLinker=<clang-wrapper> \
#     -p:SysRoot=<sysroot> \
#     -p:StripSymbols=false -p:ObjCopyName=llvm-objcopy
#
# Windows targets use MSBuild Windows.targets (CppLinker = lld-link wrapper):
#   dotnet publish -r <rid> -p:PublishAot=true \
#     -p:DisableUnsupportedError=true \
#     -p:CppLinker=<lld-wrapper> \
#     -p:IlcUseEnvironmentalTools=true \
#     -p:StripSymbols=false \
#     -p:EnableSourceLink=false
#
# Examples:
#
#   # Linux arm64 musl
#   dotnet publish -r linux-musl-arm64 -p:PublishAot=true \
#     -p:CppCompilerAndLinker=clang-aarch64-linux-musl \
#     -p:SysRoot=/usr/aarch64-linux-musl \
#     -p:LinkerFlavor=lld -p:ObjCopyName=llvm-objcopy
#
#   # macOS arm64
#   dotnet publish -r osx-arm64 -p:PublishAot=true \
#     -p:DisableUnsupportedError=true \
#     -p:CppCompilerAndLinker=clang-aarch64-apple-darwin \
#     -p:SysRoot=/usr/macosx.sdk \
#     -p:StripSymbols=false -p:ObjCopyName=llvm-objcopy
#
#   # Windows x64
#   dotnet publish -r win-x64 -p:PublishAot=true \
#     -p:DisableUnsupportedError=true \
#     -p:CppLinker=lld-x86_64-windows-msvc \
#     -p:IlcUseEnvironmentalTools=true \
#     -p:StripSymbols=false -p:EnableSourceLink=false
#
# IMPORTANT: Always pass -p:LinkerFlavor=lld for cross-architecture Linux builds.
# NativeAOT defaults to -fuse-ld=bfd which invokes the host ld.bfd — that only
# supports x86_64. Our clang wrappers already use -fuse-ld=lld internally, but
# NativeAOT injects -fuse-ld=bfd before our wrapper runs, overriding it.
# LinkerFlavor=lld tells NativeAOT to pass -fuse-ld=lld instead.
# =============================================================================

# Default ObjCopyName for all NativeAOT builds (Alpine ships GNU objcopy)
ENV ObjCopyName=llvm-objcopy

CMD ["/bin/sh"]
